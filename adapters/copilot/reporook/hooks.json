{
  "version": 1,
  "hooks": {
    "agentStop": [
      {
        "type": "command",
        "bash": "reporook scan . --quiet --fail-on critical --require-scanners",
        "powershell": "reporook scan . --quiet --fail-on critical --require-scanners",
        "cwd": ".",
        "timeoutSec": 120
      }
    ]
  }
}
