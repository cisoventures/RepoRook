{
  "contract_version": "1.0",
  "status": "release-candidate",
  "packages": [
    {
      "path": "cli/package.json",
      "name": "reporook",
      "type": "module",
      "bin": {
        "reporook": "dist/index.js"
      },
      "main": "dist/index.js",
      "exports": {
        ".": "./dist/index.js",
        "./schema": "./dist/types.js",
        "./report-validation": "./dist/report-validation.js"
      },
      "files": [
        "dist",
        "README.md"
      ],
      "engines": {
        "node": ">=20"
      },
      "runtime_exports": {
        ".": [
          "VERSION",
          "approvalMatches",
          "authenticateArtifact",
          "createApprovalReceipt",
          "createFindingBaseline",
          "createFindingSuppression",
          "createRemediationPlan",
          "detectProject",
          "initializeRepository",
          "manageIntegrations",
          "parseApprovalReceipt",
          "parseIntegrationHosts",
          "parseRemediationProposal",
          "prioritizeFindings",
          "priorityBands",
          "scanRepository",
          "severities",
          "toSarif",
          "verifyArtifactAuthentication",
          "verifyFindingResolution"
        ],
        "./schema": [
          "priorityBands",
          "severities"
        ],
        "./report-validation": [
          "assertFindingsReportConsistency",
          "parseFindingsReport"
        ]
      }
    },
    {
      "path": "mcp-server/package.json",
      "name": "@reporook/mcp-server",
      "type": "module",
      "bin": {
        "reporook-mcp": "dist/index.js"
      },
      "main": "dist/index.js",
      "exports": null,
      "files": [
        "dist",
        "README.md"
      ],
      "engines": {
        "node": ">=20"
      },
      "runtime_exports": {}
    },
    {
      "path": "service/package.json",
      "name": "@reporook/service",
      "type": "module",
      "bin": {
        "reporook-service": "dist/index.js"
      },
      "main": "dist/index.js",
      "exports": {
        ".": "./dist/server.js"
      },
      "files": [
        "dist",
        "README.md"
      ],
      "engines": {
        "node": ">=20"
      },
      "runtime_exports": {
        ".": [
          "startDashboardServer"
        ]
      }
    }
  ],
  "cli": {
    "binary": "reporook",
    "commands": [
      "approve",
      "baseline",
      "doctor",
      "explain",
      "init",
      "integrate",
      "plan",
      "prioritize",
      "scan",
      "setup",
      "suppress",
      "verify"
    ],
    "flags": [
      "--allow-external-targets",
      "--allow-no-coverage",
      "--allow-repository-suppressions",
      "--apply",
      "--approval",
      "--approval-output",
      "--approved-by",
      "--cache-ttl",
      "--changed",
      "--config",
      "--expires",
      "--fail-on",
      "--force",
      "--format",
      "--head",
      "--help",
      "--host",
      "--input",
      "--no-cache",
      "--no-sarif",
      "--output",
      "--owner",
      "--prompt-output",
      "--proposal",
      "--proposal-digest",
      "--proposal-output",
      "--quiet",
      "--reason",
      "--refresh-cache",
      "--require-scanners",
      "--sarif-output",
      "--semgrep-config",
      "--verification-output",
      "--version"
    ],
    "aliases": {
      "-h": "--help",
      "-v": "--version"
    },
    "exit_codes": {
      "0": "Complete coverage and no policy-actionable finding met the configured threshold",
      "1": "Complete coverage and at least one policy-actionable finding met the configured threshold",
      "2": "Target, configuration, required scanner, policy, or incomplete-coverage error"
    }
  },
