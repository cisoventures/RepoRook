{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://reporook.dev/schemas/remediation-proposal-1.0.json",
  "title": "RepoRook Exact Remediation Proposal",
  "type": "object",
  "required": ["schema_version", "plan_id", "finding_id", "created_at", "risk_explanation", "behavior_impact", "files", "patch", "test_plan"],
  "properties": {
    "schema_version": { "const": "1.0" },
    "plan_id": { "type": "string", "pattern": "^rrp-[a-f0-9]{12}$" },
    "finding_id": { "type": "string", "pattern": "^rr-[a-f0-9]{12}$" },
    "created_at": { "type": "string", "format": "date-time" },
    "risk_explanation": { "type": "string", "minLength": 1 },
    "behavior_impact": { "type": "string", "minLength": 1 },
    "files": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string", "minLength": 1 } },
    "patch": { "type": "string", "minLength": 1 },
    "test_plan": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } }
  },
  "additionalProperties": false
}
