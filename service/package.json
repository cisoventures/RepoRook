{
  "name": "@reporook/service",
  "version": "0.7.0",
  "description": "Local no-code dashboard for RepoRook onboarding, scans, findings, and approval-bound remediation.",
  "license": "MIT",
  "homepage": "https://github.com/cisoventures/RepoRook#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/cisoventures/RepoRook.git",
    "directory": "service"
  },
  "bugs": {
    "url": "https://github.com/cisoventures/RepoRook/issues"
  },
  "type": "module",
  "bin": {
    "reporook-service": "dist/index.js"
  },
  "main": "dist/index.js",
  "exports": {
    ".": "./dist/server.js"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json && node -e \"require('fs').chmodSync('dist/index.js',0o755)\"",
    "clean": "node -e \"require('fs').rmSync('dist',{recursive:true,force:true})\"",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "node --test"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "reporook": "0.7.0"
  }
}
